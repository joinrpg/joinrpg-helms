# Шаблон файла с доступами к Селектелу и Coroot. Секретные значения сюда не вписывать.
# Скопировать в secrets.env (он в .gitignore) и заполнить.
# Значения — в одинарных кавычках.
#
# Нужен для получения kubeconfig, синхронизации дашбордов Coroot и токена метрик DBaaS.
# Читать в каждом новом терминале (tr убирает переводы строк Windows):
#   source <(tr -d '\r' < secrets.env)

# Keystone
export OS_AUTH_URL='https://cloud.api.selcloud.ru/identity/v3'
# Номер аккаунта Селектел
export OS_USER_DOMAIN_NAME=''
# ID проекта
export OS_PROJECT_ID=''
# Имя и пароль сервисного пользователя с доступом к проекту
export OS_USERNAME=''
export OS_PASSWORD=''

# Coroot — синхронизация дашбордов через platform/coroot/scripts/sync-dashboard.py.
# URL интерфейса Coroot, без завершающего слеша.
export COROOT_URL='https://coroot.joinrpg.ru'
# ID проекта из адреса /p/<id>/..., не имя проекта и не ID проекта Selectel.
export COROOT_PROJECT_ID=''
# machine-id ВМ MSSQL: cat /etc/machine-id на ВМ, 32 символа без дефисов.
export COROOT_MACHINE_ID=''
# Логин и пароль входа в веб-интерфейс Coroot.
export COROOT_USER='admin'
# Пароль укажи только в локальном secrets.env. Если пустой — скрытый ввод.
export COROOT_PASSWORD=''
# Необязательно: пользовательский Bearer API-ключ Coroot с правом редактирования
# дашбордов (Admin/Editor). НЕ ключ проекта из coroot-project-key и НЕ ключ Selectel.
# Непустой ключ имеет приоритет над паролем. Для входа по паролю оставь ключ пустым.
export COROOT_USER_API_KEY=''

# Selectel: PostgreSQL Kaitlyn → Мониторинг → Токены для Prometheus.
# Доступ к метрикам всех DBaaS-кластеров проекта в пуле ru-6.
# Передаётся вручную в Secret coroot/selectel-dbaas-metrics, ключ token.
export SELECTEL_DBAAS_METRICS_TOKEN=''

# Ключи для отправки логов (fluent-bit) сюда не кладутся: они хранятся только
# в Secret кластера, см. platform/fluent-bit/README.md.
